+/*
+ * C20e: keep the chip-side BT service running across an HCI close/open.
+ *
+ * Android's HAL (libbt-vendor-seekwave.so, read out of the tablet's own
+ * vendor partition) never stops the chip's BT service when Bluetooth is
+ * switched off: BT_VND_OP_POWER_CTRL only logs "set power off and delay
+ * 200ms" and sleeps. It opens/closes the userspace ports and that is all.
+ *
+ * This driver instead called skw_stop_bt_service() on close and
+ * skw_start_bt_service() (which re-downloads the BT firmware into the
+ * shared chip) on open. Doing that while Wi-Fi is associated leaves the
+ * Wi-Fi data path dead until reboot: the link stays up and passes nothing,
+ * and the next Wi-Fi command times out and asserts the chip (2026-09-22).
+ *
+ * bt_keep_service=0 restores the vendor behaviour. Both the
+ * INCLUDE_NEW_VERSION (pdata->service_start/stop -- what this Makefile
+ * actually builds, via -DINCLUDE_NEW_VERSION=1) and the legacy
+ * skw_{start,stop}_bt_service paths are covered.
+ */
+static int bt_keep_service = 1;
+module_param(bt_keep_service, int, S_IRUGO);
+MODULE_PARM_DESC(bt_keep_service,
+        "keep the chip BT service running across HCI close/open, as Android does (default 1)");
+static int bt_service_running;
+

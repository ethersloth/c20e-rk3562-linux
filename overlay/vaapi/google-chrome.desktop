[Desktop Entry]
# Overrides Google Chrome's own launcher entry so the app grid starts Chrome
# through /usr/local/bin/google-chrome-stable (hardware video decode enabled).
# It wins because XDG_DATA_DIRS lists /usr/local/share before /usr/share, and a
# Chrome package update cannot undo it -- it never writes here.
#
# TryExec points at Chrome's real binary, so this entry disappears from the menu
# on a tablet where Chrome is not installed.
Version=1.0
Name=Google Chrome
GenericName=Web Browser
Comment=Browse the web (hardware video decode)
Exec=/usr/local/bin/google-chrome-stable %U
TryExec=/opt/google/chrome/google-chrome
StartupNotify=true
StartupWMClass=google-chrome
Terminal=false
Icon=google-chrome
Type=Application
Categories=Network;WebBrowser;
MimeType=application/pdf;application/rdf+xml;application/rss+xml;application/xhtml+xml;application/xhtml_xml;application/xml;image/gif;image/jpeg;image/png;image/webp;text/html;text/xml;x-scheme-handler/http;x-scheme-handler/https;
Actions=new-window;new-private-window;

[Desktop Action new-window]
Name=New Window
Exec=/usr/local/bin/google-chrome-stable

[Desktop Action new-private-window]
Name=New Incognito Window
Exec=/usr/local/bin/google-chrome-stable --incognito
